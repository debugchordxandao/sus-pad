# Porta do servidor HTTP / WebSocket (Railway e Render definem automaticamente)
PORT=3000

# Ambiente: production ou development
NODE_ENV=production

# Chave secreta longa para assinatura de tokens JWT (ex: openssl rand -hex 32)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_com_pelo_menos_32_caracteres

# Diretório para armazenamento do banco de dados persistente (SQLite / JSON)
# No Railway: /app/data (com Volume montado em /app/data)
# No Render:  /var/data (com Disk montado em /var/data)
# Em desenvolvimento local: ./data
DATA_DIR=./data

